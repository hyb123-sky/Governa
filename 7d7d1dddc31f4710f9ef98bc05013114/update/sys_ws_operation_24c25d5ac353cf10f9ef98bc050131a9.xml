        <name>Update run</name>
        <operation_script><![CDATA[(function process(request, response) {
    var runId = request.pathParams.run_id;
    var body = request.body.data;
    var gr = new GlideRecord('x_1821654_governa_run');
    if (!gr.get(runId)) { response.setStatus(404); return { error: 'run not found' }; }
    if (gr.getValue('outcome')) { response.setStatus(409); return { error: 'run already finalized' }; }
    var allowed = ['outcome','steps','input_tokens','output_tokens','trace_hash'];
    for (var i = 0; i < allowed.length; i++) {
        var k = allowed[i];
        if (body[k] !== undefined) gr.setValue(k, body[k]);
    }
    gr.setValue('ended_at', new GlideDateTime());
    gr.update();
    return { sys_id: runId, outcome: gr.getValue('outcome') };
})(request, response);]]></operation_script>
